rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - description: string (required, 1-500 chars)
    //   - price: number (required, positive)
    //   - category: string (required, 'soft' or 'gelato')
    //   - image: string (required, valid URL)
    //
    // Collection: orders
    // Document ID: auto-generated
    // Fields:
    //   - items: list (required, max 50 items)
    //   - total: number (required, positive)
    //   - mode: string (required, 'in-store' or 'delivery')
    //   - customerName: string (required, 1-100 chars)
    //   - customerPhone: string (required, 1-20 chars)
    //   - customerAddress: string (optional for in-store, required for delivery)
    //   - location: map (optional, {lat: number, lng: number})
    //   - status: string (required, 'pending', 'preparing', 'delivered')
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "greicf15@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    function isPositive(field) {
      return request.resource.data[field] is number && request.resource.data[field] > 0;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProduct(data) {
      return hasRequiredFields(['name', 'description', 'price', 'category', 'image']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.price is number && data.price > 0 &&
             data.category in ['soft', 'gelato'] &&
             isValidUrl(data.image);
    }

    function isValidOrder(data) {
      return hasRequiredFields(['items', 'total', 'mode', 'customerName', 'customerPhone', 'status', 'createdAt']) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.total is number && data.total > 0 &&
             data.mode in ['in-store', 'delivery'] &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 20 &&
             data.status in ['pending', 'preparing', 'delivered'] &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Products: Publicly readable, only admins can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidProduct(request.resource.data);
    }

    // Orders: Anyone can create (public ordering), but only admins can read/update/delete
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Users: Only admins can manage roles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
