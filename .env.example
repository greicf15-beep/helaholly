# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform APIs.
# For production builds (Hostinger), use the VITE_ prefix.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# SISTEMA_API_KEY: Clave de seguridad para la API del sistema administrativo.
# Si no se define, se usa la clave predeterminada del sistema.
SISTEMA_API_KEY=holly_sistema_sec_2026
