<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permitir cabeceras de autorización en Hostinger/Apache
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

  # Rutas de la API para el Sistema Administrativo en Hostinger
  RewriteRule ^api/sistema(/.*)?$ api/sistema/index.php [QSA,L]
  RewriteRule ^api/orders(/.*)?$ api/sistema/index.php [QSA,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/otf .otf
  AddType font/ttf .ttf
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|webp|css|js)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
