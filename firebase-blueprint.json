{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A Hollywood ice cream product (Gelato or Soft).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the ice cream." },
        "description": { "type": "string", "description": "Description of the ice cream." },
        "price": { "type": "number", "description": "Price of the ice cream." },
        "category": { "type": "string", "enum": ["soft", "gelato"], "description": "Category of the ice cream." },
        "image": { "type": "string", "description": "URL of the product image." }
      },
      "required": ["name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order for ice cream.",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "integer" }
            }
          }
        },
        "total": { "type": "number" },
        "mode": { "type": "string", "enum": ["in-store", "delivery"] },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "status": { "type": "string", "enum": ["pending", "preparing", "delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "total", "mode", "customerName", "customerPhone", "status", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of ice cream products."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders."
    }
  }
}
